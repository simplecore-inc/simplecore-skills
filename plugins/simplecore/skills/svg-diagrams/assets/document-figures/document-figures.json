{
  // Copy to <project>/.claude/document-figures.json and set every value for the
  // document. The schema is in the skill's references/document-figures.md.
  "out": "docs/assets/diagrams",
  "modules": ["tools/diagrams/*.py"],
  "helpers": [],

  // Board width in units -> placed width in px. A4 with 25.4mm margins is a
  // 602px text column, so a 1200-unit board placed across it scales by 0.5017.
  // A column board takes the same scale: 300px / 0.5017 = 598 units.
  // Where a deck places these figures, boards and placeScale name the deck
  // config that owns them instead ({from, key}, references/document-figures.md).
  "boards": { "1200": 602, "598": 300 },
  "boardNames": { "FULL": 1200, "COLUMN": 598 },
  "columnBoard": 598,
  "placeScale": 1.0,
  "margin": 28,
  "sideMargin": 28,

  // A placeholder ladder: the starting table in references/document-figures.md,
  // with each name on the rung that table gives its role (MICRO the dense
  // micro-label, BODY the body). It is not derived for this placement. Derive
  // the document's own from its body size and the placed width as that
  // reference says: at this sample's 0.5017 scale a 10pt body needs 27 units,
  // and the tag rung's 6.4pt floor needs 18.
  "ladder": [15, 16, 17, 18, 20, 21, 24],
  "names": { "MICRO": 15, "BODY": 17, "LEAD": 18, "CARD": 18, "SECTION": 20,
             "EMPH": 21, "DISPLAY": 24 },
  "steps": { "STEP": 18 },
  "subBodyShareMax": null,
  "maxRung": null,

  "strokes": { "HAIRLINE": 1.4, "STROKE": 1.9, "THICK": 2.8 },
  "dashes": {
    "DASH_PENDING": { "pattern": "6 5", "words": ["not yet decided"] },
    "DASH_OUTSIDE": { "pattern": "5 4", "words": ["outside scope"] },
    "DASH_ALT":     { "pattern": "4 4", "words": ["alternative"] },
    "DASH_BLOCK":   { "pattern": "3 3", "words": ["prohibited"] }
  },
  "dashWord": "dashed",

  "theme": "paper",
  "fontStack": null,
  "icon": { "size": 20, "sw": 1.6 },
  "icons": { "model": "brain-circuit", "store": "database", "person": "user-round" },
  "accents": {},
  "badges": {},
  "verdict": null,
  "bullets": true,
  "noBreak": [],

  "heightReview": { "1200": 840, "598": 1400 },
  "deadMargin": null,
  "stripRatio": 0.28,
  "legendWords": { "dashed": ["dashed"] },
  "footLegend": null,
  "labelForm": {},
  "register": null,
  "sectionNumbers": true,
  // contrastFloor is left unset: every label is then held to WCAG's floor for
  // its printed size, 4.5 under the large-text size and 3.0 at it. A number
  // holds every label to it; null turns the check off.
  "references": null,
  "plans": null
}
