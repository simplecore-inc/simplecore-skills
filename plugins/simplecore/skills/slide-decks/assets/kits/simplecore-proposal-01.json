{
  // The component vocabulary of the SlideGlance kit simplecore-proposal-01, as the
  // shared deck checks read it (scripts/bidkit/vocab.py). Every name here is a
  // template or parameter the kit defines; a project that adds its own components
  // overrides a class with a file named by `vocabulary.override`.
  //
  // Slot syntax: `arg` is an argument's value, `arg[].key` is the `key` of every item
  // in the JSON list `arg` holds, and `arg[0][]` is every cell of the first row of the
  // JSON grid `arg` holds (a table's header row).
  "kit": "simplecore-proposal-01",

  "pages": {
    // The running head every body page draws, and which of its arguments carry the
    // part number, the chapter line, the page title, the explanation under it, the
    // evaluation item the page answers and the requirement ids it answers.
    "head": { "component": "sg-master-head", "part": "tone", "chapter": "chapter", "title": "title",
              "sub": "sub", "evalItem": "badge", "reqs": "refTitle" },
    // Master name prefixes. A body page's master is BODY-<part>; a divider's PART-<part>.
    // Folioless masters carry no folio while no folio has been counted yet (cover and
    // contents) and again once the body has closed on an unnumbered or annex page (the
    // plain cover in front of all the annexes); annex masters carry their own series and
    // are outside the body count.
    "masters": {
      "body": ["BODY"],
      "divider": ["PART"],
      "folioless": ["COVER", "TOC", "PLAIN"],
      // Masters that never print a folio and are never counted, wherever they stand (the
      // closing page after the annexes).
      "unnumbered": ["END"],
      "annex": ["ANNEX"],
      "fullBleed": ["COVER", "TOC", "PART", "ANNEX-END", "END"]
    },
    // The page components a source file opens a page with.
    "components": { "body": ["page"], "contents": ["toc"], "divider": ["part"], "annexDivider": ["annex-part"] }
  },

  // The contents component's rows: the data field each printed number and page is
  // bound to (`←row[i].<field>` in the content reading), per level.
  "contents": {
    "part": { "number": "ch.no", "page": "ch.page" },
    "chapter": { "number": "it.no", "page": "it.page" }
  },

  // The faces the kit sets its type in; `sans` is the face a figure's labels are
  // printed in when a deliverable PDF inlines the figure.
  "fonts": { "sans": "Pretendard", "serif": "KoPubBatang" },

  "slots": {
    // Name slots: titles, heads and labels, which take a noun phrase.
    "name": {
      "page": ["title", "chapter"],
      "toc": ["title"],
      "part": ["name", "cells[].head"],
      "annex-part": ["title", "cells[].head"],
      "heading": ["text"],
      "section": ["head"],
      "figure": ["caption"],
      "notice": ["label"],
      "keyrow": ["label"],
      "stage": ["head"],
      "axis-card": ["head", "aLabel", "bLabel"],
      "fact-band": ["statLabel", "labelA", "labelB", "labelC"],
      "value-chain": ["headA", "headB", "headC", "items[].a"],
      "stat-grid": ["items[].label"],
      "deflist": ["items[].term"],
      "evidence-stat": ["claim"],
      "table": ["rows[0][]"]
    },
    // Prose blocks: a paragraph of the page's own argument.
    "prose": {
      "prose": ["text"],
      "text-note": ["text"],
      "note": ["text"],
      "notice": ["text"]
    },
    "caption": { "figure": ["caption"] },
    "sub": { "page": ["sub"] }
  },

  // Argument classes for a check that traces printed copy to the manuscript.
  "args": {
    // Deck furniture: set by the typesetter and checked against the furniture source.
    "furniture": ["title", "sub", "caption", "chapter", "part", "refTitle", "badge", "notes",
                  "description", "no", "name", "kicker", "locator", "lede", "cells"],
    // Layout and data that are not printed copy.
    "layout": ["template", "src", "alt", "tone", "icon", "w", "h", "variant", "size", "master",
               "termW", "labelW", "figW", "aGrow", "bGrow", "stretch", "marker", "numbered",
               "lastTotal", "level", "code", "folioPrefix", "folioRestart", "columns", "when",
               "frame", "align", "valign"],
    // Plain arguments holding a sentence of the document's own.
    "prose": ["text", "aText", "bText", "value", "claim", "condition", "statNote",
              "noteA", "noteB", "noteC"],
    // Plain arguments holding a head or a label.
    "heads": ["head", "label", "aLabel", "bLabel", "headA", "headB", "headC",
              "statLabel", "labelA", "labelB", "labelC"]
  },

  // Sentence slots, in reading order: the arguments and item fields that carry a
  // sentence of the page's own, which closes on a predicate and takes a full stop
  // (checks period and dangle). Plain arguments listed together are one claim split
  // over rows, so only the last one present has to finish it; every item of a JSON
  // list is a row of its own. Names (heads, labels, terms) are never listed here.
  "sentences": {
    "page": ["sub"],
    "prose": ["text"], "lead": ["text"], "term-para": ["text"], "text-note": ["text"],
    "note": ["text"], "notice": ["text"], "callout": ["text"], "quote": ["text"],
    "list": ["items[].text", "items[].sub"], "list-row": ["text", "sub"],
    "checklist": ["items[].text"], "keyrow": ["value"], "deflist": ["items[].definition"],
    "steps": ["items[].body"], "step-row": ["body"], "delta-row": ["body"],
    "ledger-row": ["demand", "answer"], "branch-detail": ["sub"], "paired-note": ["aText", "bText"],
    "event-detail": ["body"],
    "card": ["body"], "pair-card": ["aText", "bText"], "choice-card": ["aText", "bText", "tail"],
    "trio-card": ["aText", "bText", "cText"], "card-split": ["leftText", "rightText"],
    "axis-card": ["aText", "bText"], "trigger-card": ["aText", "bText"],
    "decision-card": ["body", "tail"], "proof-strip": ["body", "tail"], "proof-line": ["body", "tail"],
    "item": ["body"], "copy-rail": ["sub"], "stage": ["body"], "panel-row": ["mid", "end"],
    "transform-lane": ["inNote", "opNote", "outNote"], "fact-band": ["statNote", "noteA", "noteB", "noteC"],
    "lane": ["body", "foot"], "icon-band": ["body"], "anchor-row": ["sub"], "marker-band": ["sub"],
    "key-summary": ["items[].body"], "value-chain": ["items[].b", "items[].c"],
    "risk-response": ["items[].detail", "items[].response"], "trace-matrix": ["items[].how"],
    "level-ladder": ["items[].criterion", "items[].action"], "quadrant": ["cells[].body"],
    "timeline": ["items[].body"], "flow": ["steps[].note"], "num-step": ["note"], "flow-step": ["note"],
    "fig-column": ["notes[].body"], "evidence-stat": ["condition"], "kpi": ["note"]
  },

  // How the checks group components by the kind each declares on its <Template>
  // (read from the server, so a component the kit adds is grouped without a list).
  "kinds": {
    // A shaped block: what carries a page other than paragraphs and a plain list.
    "shape": ["card", "chart", "figure", "flow", "kpi", "steps", "table", "list-row", "box", "note"],
    // Content components: the blocks a page is composed of, counted by the census and
    // by the one-component-carries-the-page rule. Figures and tables are not among them.
    "content": ["card", "flow", "kpi", "steps", "list-row", "box", "note", "chip"],
    // Kinds that are never vocabulary a page reaches for.
    "held": ["internal"]
  },

  // Component roles a check needs, by name. A deck overrides one with
  // `checks.<check>.<role>` in its declaration.
  "roles": {
    // Plain list rows and the container that sets their gap; a row outside it takes the
    // gap of whatever slot it lands in. `listItems` is the container's own item list.
    "listRows": ["list-row"],
    "listContainers": ["list"],
    "listItems": "items",
    // The argument a list row or a list item carries a supplied mark in.
    "markArg": "mark",
    // Label and value rows, with the argument holding the label; the label column is
    // fixed for alignment, so an index does not belong in it.
    "labelRows": { "keyrow": "label" },
    // Components that are shapes for the composition rules even where their kind is not,
    // and components whose kind is a shape kind but which are only frames or furniture.
    "notShapes": ["list-row", "frame", "canvas", "fill", "rule", "panel", "block", "toc-annex",
                  "toc-head", "toc-part", "toc-row", "toc-annex-row"],
    // Figures, and the layouts that place one beside the text. A side layout maps to the
    // side its figure stands on, or to `arg:<name>` when an argument chooses it.
    "figures": ["figure", "screenshot"],
    "figureSide": { "fig-left": "left", "fig-right": "right", "fig-column": "arg:side" },
    "figurePair": ["fig-pair"],
    "rails": ["rail"],
    "columnLayouts": ["cols2", "cols3", "span-cols"],
    // Components that number a sequence, with the argument holding the number.
    "numbered": { "step-row": "no", "num-step": "no", "stage-cell": "no", "stage-detail": "no",
                  "panel-row": "no", "marker-band": "no" },
    // Components that repeat by design because their content is a sequence or a register;
    // the one-component rule still reports them, with that named.
    "sequences": ["step-row", "num-step", "stage-detail", "stage-cell", "ledger-row", "steps", "timeline"],
    // Region heads that can carry the requirement ids their region answers, with the
    // argument they carry them in, and standalone badges with theirs.
    "regionIds": { "section": "code", "section-bar": "code", "heading": "code", "block": "code" },
    "badgeIds": { "req-chips": "items[].ids", "chip": "text" },
    // Code values standing as labels (a requirement id on a chip), held to the code-label
    // floor rather than the type floor when the deck declares one.
    "codeLabels": ["chip", "badge", "req-chips"],
    // The argument a figure component prints its number in (「그림 Ⅲ-1」).
    "figureNumber": { "figure": "no", "figure-caption": "no" },
    // Components that open a region, with the argument holding the region's title, and
    // the arguments that are a component's own head: a region's title and the head of
    // the first component under it must differ, or one of the two carries nothing.
    "regions": { "section": "head", "section-bar": "head", "heading": "text", "block": "head" },
    "regionHeads": ["head"]
  },

  // A label and the prose it stands in front of, per component, in reading order. Slot
  // syntax as in `slots`; a pair of `arg[].key` slots on one list is read item by item.
  // A label that repeats its own prose's opening word carries nothing (check markecho).
  "marks": {
    "keyrow": [["label", "value"]], "anchor-row": [["label", "value"]],
    "notice": [["label", "text"]], "note": [["mark", "text"]], "list-row": [["mark", "text"]],
    "list": [["items[].mark", "items[].text"]], "term-para": [["term", "text"]],
    "deflist": [["items[].term", "items[].definition"]],
    "callout": [["head", "text"]], "card": [["head", "body"]], "item": [["head", "body"]],
    "proof-line": [["head", "body"]], "delta-row": [["head", "body"]], "icon-band": [["head", "body"]],
    "stage": [["head", "body"]], "step-row": [["head", "body"]], "decision-card": [["head", "body"]],
    "lane": [["head", "body"]], "event-detail": [["head", "body"]], "flow-step": [["head", "note"]],
    "num-step": [["head", "note"]], "proof-strip": [["tailLabel", "tail"]],
    "ledger-row": [["answerLabel", "answer"]],
    "panel-row": [["midLabel", "mid"], ["endLabel", "end"]],
    "axis-card": [["aLabel", "aText"], ["bLabel", "bText"]],
    "pair-card": [["aLabel", "aText"], ["bLabel", "bText"]],
    "choice-card": [["aLabel", "aText"], ["bLabel", "bText"]],
    "trigger-card": [["aLabel", "aText"], ["bLabel", "bText"]],
    "trio-card": [["aLabel", "aText"], ["bLabel", "bText"], ["cLabel", "cText"]],
    "card-split": [["leftLabel", "leftText"], ["rightLabel", "rightText"]],
    "steps": [["items[].head", "items[].body"]], "timeline": [["items[].head", "items[].body"]],
    "key-summary": [["items[].head", "items[].body"]], "fig-column": [["notes[].head", "notes[].body"]],
    "flow": [["steps[].head", "steps[].note"]], "value-chain": [["items[].a", "items[].b"]],
    "risk-response": [["items[].risk", "items[].detail"]]
  },

  // The inks fine print is set in: lead, caption, footnote (doc.inkMuted). The body ink
  // (doc.inkBody) is not one.
  "palette": { "fine": ["646B77"] }
}
