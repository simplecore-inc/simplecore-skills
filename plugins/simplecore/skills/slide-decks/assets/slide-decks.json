{
  // The decks this repository typesets, read by the slide-decks skill and by each deck's
  // own checks. Paths are relative to the repository root. Edit as text:
  // a JSON round-trip drops these comments and the per-key layout.
  "decks": {
    "proposal": {
      "dir": "pptx",
      "kind": "document",
      // the deck tool, its authoring skill, the server that owns this deck, and the entry file
      "tool": { "name": "slideglance", "skill": "slideglance-pptx", "server": "slideglance-proposal",
                "entry": "main.sgx" },
      // the kit vocabulary the shared checks read (skills/slide-decks/assets/kits/<kit>.json)
      "vocabulary": "simplecore-proposal-01",
      // page ids and folios: the part numerals in order and the id format
      "pages": { "numerals": ["Ⅰ", "Ⅱ", "Ⅲ", "Ⅳ", "Ⅴ", "Ⅵ", "Ⅶ", "Ⅷ"], "id": "{part}-{chapter} {ordinal:02}" },
      // the sizes this deck is set at, in points; codeLabel null where that class is not measured
      "type": { "floor": 8, "codeLabel": null },
      // the register's closing syllable and stop, read by the sentence checks
      "lang": { "sentenceEnd": "다." },
      // what the tender calls the annex, so the deck writes its word
      "annex": { "term": "별첨" },
      "page": { "w": 794, "h": 1123, "textBlock": 682 },
      // the manuscript and its conventions: printed part, page heading, declaration, caption
      "manuscript": { "dir": "proposal", "printed": "## 인쇄 원고", "page": "### ",
                      "declaration": "<!--\\s*md:", "caption": "^캡션: ",
                      "exclude": ["README.md", "00-서식/**"], "annex": ["10-별첨/**"],
                      "skipLines": ["^\\*\\*대응 요구사항[::]"] },
      // the requirement digest whose headings issue the ids, and the id shape
      "requirements": { "source": "docs/requirements.md",
                        "id": { "prefix": "[A-Z]{3}[-_]", "digits": 3 },
                        "notAnId": [],
                        "absence": "제안요청서에 (?:없다|없음|없습니다)",
                        "manuscriptLine": "^>\\s*대응 요구사항[::]\\s*(.*)$" },
      // the transcribed tender the citations are read against
      "rfp": { "dir": "docs/rfp/md" },
      // the evidence notation; null when the deck cites no evidence items
      "evidence": { "tag": "증빙", "table": "proposal/00-서식/07-평가항목-조견표.md", "pagesColumn": -1 },
      // the numbered-page ceiling, the tender clause it comes from, and the capacity
      // estimate the volume check reads
      "budget": { "maxNumbered": 100, "clause": "제안요청서 「나. 서류 제출방법 3)」", "plan": "docs/page-plan.md",
                  "charsPerPage": { "figure": 650, "text": 1150 }, "pageTolerance": 1.1 },
      // the tender's scoring table and the proposal's lookup table as the deck prints it
      "evaluation": { "scoring": { "file": "docs/rfp/md/05-평가.md", "section": "## 평가 항목",
                                   "columns": { "item": "평가항목", "element": "평가요소" } },
                      "lookup": { "deck": true, "columns": { "item": "평가항목", "pages": "관련 페이지" } } },
      // the Jev gateway the claims triage asks; the key is read from the environment
      "jev": { "claims": { "evidence": "별첨|증빙|실측|시험환경" } },
      "instructions": ["pptx/AGENTS.md", "pptx/README.md"],
      "render": "cd pptx && npm run render",
      "output": "pptx/out/제안서.pptx",
      "previews": "pptx/out/png",
      "renderer": { "command": "slideglance", "minVersion": "0.2.0" },
      "deliverable": { "label": "비계량", "pdfScale": 1.0 },
      "figures": {
        "sources": ["proposal/diagrams"],
        "generator": "tools/diagrams",
        "verify": "tools/diagrams/verify",
        // board width in drawing units -> placed width in page px
        "boards": { "1200": 682, "520": 300, "520-pair": 327 },
        // the printed figure number: the body series and an annex's own series
        "numbering": { "caption": "그림 {part}-{n}", "annex": "그림 별첨{a}-{n}" }
      },
      // Check names, run by skills/slide-decks/scripts/check.py: a name resolves to
      // <local>/<name>.py first, then to the shared check of that name. The delivery
      // is run on demand (check.py run deliver), never declared in a phase.
      "checks": {
        "preflight": ["abspath", "typefloor", "contents", "chapter_pages", "evaluation"],
        "after": ["renderer", "layout", "rowheight", "finetype", "pageshape", "rhythm", "grade",
                  "listrow", "period", "dangle", "naming", "markecho", "echo", "twice", "samefact",
                  "figures", "figtext", "parity", "carry", "mdorder", "fignum", "secref", "reqid",
                  "reqbadge", "rfpwords", "rfpcite", "proof", "coltotal", "samecol", "budget",
                  "volume", "mdtwice"],
        "local": "tools/deck",
        // one <check>.json per check: {finding: reason}
        "baselines": "tools/deck/baselines",
        // a local script that is not a check, and why
        "excluded": { "deckio": "the reader the local checks import" },
        // options a deck sets away from the shared defaults
        "twice": { "sentences": true, "minLen": 28 },
        "abspath": { "generated": ["pptx/out/**"] }
      },
      "korean": {
        "audit": ["pptx/chapters", "pptx/templates", "pptx/styles", "pptx/README.md"]
      },
      "review": { "prompt": "docs/persona-review.md", "records": "docs/reviews/persona" }
    },
    "presentation": {
      "dir": "pptx-presentation",
      "kind": "slides",
      "tool": { "name": "slideglance", "skill": "slideglance-pptx", "server": "slideglance-presentation" },
      "page": { "w": 1123, "h": 794, "textBlock": 1027 },
      // the manuscript a slide deck is built from: the presentation plan, one section per slide
      "plan": "proposal/11-요약서/01-20분-발표스크립트-슬라이드계획.md",
      // the document deck whose sections the running head cites (「본 제안서 Ⅳ-2 · 57~101쪽」)
      "references": { "deck": "proposal" },
      "instructions": ["pptx-presentation/AGENTS.md", "pptx-presentation/README.md"],
      "render": "cd pptx-presentation && npm run render",
      "output": "pptx-presentation/out/제안발표.pptx",
      "previews": "pptx-presentation/out/png",
      "deliverable": { "label": "요약서", "pdfScale": 1.0 },
      "screens": "pptx-presentation/assets/screens",
      "figures": {
        // The reused figures are a snapshot this deck owns, not a live read of
        // the document deck's directory: the figure snapshot check is the only
        // writer and reports the drift when it is not run.
        "sources": ["<slides.dir>/assets/figures", "<slides.dir>/diagrams"],
        "upstream": "<document.dir-relative figure directory>",
        "generator": "pptx-presentation/tools/diagrams",
        "verify": "pptx-presentation/tools/diagrams/verify",
        // One scale for every board so type inside a diagram is the same size on
        // every page. A slide deck takes no width variants: a chapter that wants a
        // figure wider is asking for a different board.
        "scale": 0.5666,
        "boards": { "1800": 1020, "1200": 680, "880": 499, "520": 295 }
      },
      // refpages, coverage, census, density, verdict and colfill are this deck's own
      // checks under checks.local; no shared check holds those properties
      "checks": {
        "preflight": ["abspath", "typefloor", "refpages", "coverage"],
        "after": ["rowheight", "census", "density", "verdict", "colfill"],
        "local": "pptx-presentation/tools",
        "baselines": "pptx-presentation/tools/baselines",
        "census": { "sequences": ["process-strip", "flow-row", "stage-strip", "flow-down"],
                    "sequenceRows": ["step-row", "ladder-step", "stage-detail"], "maxShare": 0.34,
                    // The rows a slide closes a region on. One of them on nearly
                    // every body slide makes the run read as one slide mirrored,
                    // and no sequence rule reaches it.
                    "closers": ["arrow-pair", "ruled-note", "delta-row"],
                    "maxCloserShare": 0.75 },
        "density": { "maxChars": 1300, "maxShapes": 24 },
        // The judgement pair: the two hexes, the shapes that may carry them and
        // which slot of each holds the block and the pass label, and the words
        // each slot may print. A pair that is neither takes a neutral twin.
        "verdict": {
          "block": "B6382B",
          "pass": "507C39",
          "templates": {
            "trigger-card": { "blockSlot": "aLabel", "passSlot": "bLabel" },
            "verdict-row": { "blockSlot": "endLabel", "passSlot": "midLabel" }
          },
          "blockWords": ["차단", "오류", "통제", "제한", "보류", "반려", "실패", "위반", "누락"],
          "passWords": ["통과", "허용", "처리", "보존", "적합", "충족", "완료", "승인", "정상"]
        },
        // A column layout is measured per column: the page-level fill number is
        // met by whichever column runs longest. Each layout gives its columns'
        // x ranges inside the text block, measured from its left edge.
        "colfill": {
          "maxGap": 0.15,
          // A gap rule alone passes a page whose columns are both short, so the
          // floor is declared beside it.
          "minFill": 0.80,
          "textBlock": { "x": 48, "top": 150, "bottom": 752 },
          "layouts": {
            "cols-wide-left":  [[0, 680], [708, 1027]],
            "cols-wide-right": [[0, 319], [347, 1027]],
            "cols2":           [[0, 507], [520, 1027]],
            "cols3":           [[0, 333], [347, 680], [694, 1027]]
          }
        }
      },
      "korean": {
        "audit": ["pptx-presentation/chapters", "pptx-presentation/templates",
                  "pptx-presentation/styles", "pptx-presentation/README.md"]
      }
    }
  },
  "submission": {
    "dir": "제출물",
    "title": "<사업명>_제안서",
    "date": "2026년 9월 15일",
    "pdfLimitMB": { "file": 50, "total": 180 },
    "pdf": { "engine": "slideglance", "imageDpi": 150, "jpegQuality": 88 },
    // the blind copy is built last; with two copies, one render command per copy
    "blindCopy": "평가본",
    "build": "{render} --copy {copy}",
    "copies": {
      "원본":   { "volumes": ["proposal", "presentation"] },
      "평가본": { "volumes": ["proposal", "presentation"] }
    },
    "identity": {
      "원본":   { "name": "<제안사 상호>", "label": "제안사", "logo": "docs/reference/logo.svg" },
      "평가본": { "name": "\u00a0", "label": "\u00a0" }
    }
  }
}
